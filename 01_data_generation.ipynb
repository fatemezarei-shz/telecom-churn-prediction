import numpy as np
import pandas as pd

np.random.seed(42)

n_customers = 50000

# Static features
customer_id = np.arange(1, n_customers + 1)
contract_type = np.random.choice(['prepaid', 'postpaid'], size=n_customers, p=[0.6, 0.4])
contract_duration = np.random.randint(1, 36, size=n_customers)
age = np.random.randint(18, 70, size=n_customers)

# Usage features
avg_call_minutes = np.random.normal(loc=300, scale=80, size=n_customers)
avg_data_usage_gb = np.random.normal(loc=10, scale=3, size=n_customers)
avg_sms_count = np.random.normal(loc=50, scale=20, size=n_customers)
roaming_usage = np.random.binomial(1, 0.2, size=n_customers)
number_of_complaints = np.random.poisson(lam=1.5, size=n_customers)
payment_delay_days = np.random.poisson(lam=3, size=n_customers)

df = pd.DataFrame({
    "customer_id": customer_id,
    "contract_type": contract_type,
    "contract_duration": contract_duration,
    "age": age,
    "avg_call_minutes": avg_call_minutes,
    "avg_data_usage_gb": avg_data_usage_gb,
    "avg_sms_count": avg_sms_count,
    "roaming_usage": roaming_usage,
    "number_of_complaints": number_of_complaints,
    "payment_delay_days": payment_delay_days
})

df.head()
